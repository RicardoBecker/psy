# Copie para devOps/.env e ajuste antes de subir em uma rede compartilhada.
# docker compose carrega este arquivo automaticamente (mesma pasta do docker-compose.yml).

JWT_SECRET=troque_por_um_segredo_forte_antes_de_expor_na_rede

# Login com Google (KAN-15) e Apple (KAN-16). Ver .env.example na raiz para
# o racional — mesmo Client ID/Services ID nos dois lados (backend valida
# audience, frontend inicia o SDK de cada provedor).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Recuperação de senha (KAN-17). Ver .env.example na raiz para o racional.
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@seudominio.com
