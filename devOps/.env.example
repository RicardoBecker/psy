# Copie para devOps/.env e ajuste antes de subir em uma rede compartilhada.
# docker compose carrega este arquivo automaticamente (mesma pasta do docker-compose.yml).

JWT_SECRET=troque_por_um_segredo_forte_antes_de_expor_na_rede

# Login com Google (KAN-15). Ver .env.example na raiz para o racional —
# mesmo Client ID nos dois lados (backend valida audience, frontend inicia
# o Google Identity Services).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
