generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PSYCHOLOGIST
  PATIENT
  GUARDIAN
}

enum AgeGroup {
  ADULT
  ADOLESCENT
  CHILD
}

enum ConsentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsentRecordStatus {
  ACTIVE
  REVOKED
}

// 🔒 KAN-15/KAN-16: provedores de identidade federada suportados. Cada
// valor novo chega numa migration própria — não reescrevemos uma migration
// depois de aplicada.
enum AuthProvider {
  GOOGLE
  APPLE
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  // 🔒 KAN-15: opcional porque contas criadas via login social (ver
  // SocialIdentity) nunca definem senha local — AuthService.validateUser
  // trata passwordHash nulo como "login por senha indisponível", nunca
  // como senha vazia/qualquer.
  passwordHash String?   @map("password_hash")
  role         Role      @default(PATIENT)
  ageGroup     AgeGroup  @default(ADULT)
  birthDate    DateTime?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  // 🔒 KAN-17: timestamp da última troca de senha (só setado por um reset
  // de verdade, nunca no cadastro). JwtStrategy usa isto para invalidar
  // qualquer token emitido ANTES desse instante — é assim que "nova senha
  // invalida sessões anteriores" funciona sem precisar de uma tabela de
  // sessões/blacklist de JWT.
  passwordChangedAt DateTime? @map("password_changed_at")

  // Relacionamentos existentes
  emotionalCheckins EmotionalCheckin[]
  journalEntries    JournalEntry[]

  // Novos relacionamentos
  psychologistProfile    PsychologistProfile?
  guardianRelationships  GuardianRelationship[] @relation("GuardianUser")
  minorRelationships     GuardianRelationship[] @relation("MinorUser")
  consentRecords         ConsentRecord[]        @relation("UserConsent")
  guardianConsentRecords ConsentRecord[]        @relation("GuardianConsent")
  patientLinks           PatientPsychologistLink[] @relation("PatientLinks")
  psychologistLinks      PatientPsychologistLink[] @relation("PsychologistLinks")
  socialIdentities       SocialIdentity[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

// 🔒 KAN-15: vínculo entre um User e uma identidade num provedor externo.
// A dupla (provider, providerUserId) é o `sub` verificado no ID token — é
// a única coisa em que confiamos para reconhecer a conta num login
// seguinte; nunca o e-mail sozinho (e-mail pode ser trocado no provedor).
model SocialIdentity {
  id             String       @id @default(uuid())
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String
  userId         String       @map("user_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_identities")
}

// 🔒 KAN-17: guarda só o HASH do token de recuperação (SHA-256), nunca o
// valor cru — o mesmo raciocínio de nunca guardar senha em texto plano.
// `usedAt` faz o token ser de uso único; `expiresAt` limita a janela de
// validade. Uma nova solicitação (AuthService.forgotPassword) invalida
// qualquer token anterior ainda não usado do mesmo usuário.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model GuardianRelationship {
  id                 String        @id @default(uuid())
  minorUserId        String        @map("minor_user_id")
  guardianUserId     String        @map("guardian_user_id")
  relationshipType   String        @map("relationship_type")
  consentStatus      ConsentStatus @default(PENDING) @map("consent_status")
  createdAt          DateTime      @default(now()) @map("created_at")

  minorUser    User @relation("MinorUser", fields: [minorUserId], references: [id], onDelete: Cascade)
  guardianUser User @relation("GuardianUser", fields: [guardianUserId], references: [id], onDelete: Cascade)

  @@unique([minorUserId, guardianUserId])
  @@map("guardian_relationships")
}

model ConsentRecord {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  guardianUserId String?            @map("guardian_user_id")
  consentType   String              @map("consent_type")
  status        ConsentRecordStatus @default(ACTIVE)
  grantedAt     DateTime            @default(now()) @map("granted_at")
  revokedAt     DateTime?           @map("revoked_at")

  user     User  @relation("UserConsent", fields: [userId], references: [id], onDelete: Cascade)
  guardian User? @relation("GuardianConsent", fields: [guardianUserId], references: [id])

  @@map("consent_records")
}

model PsychologistProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique @map("user_id")
  bio                String?
  specialties        String[] @default([])
  registrationNumber String?  @map("registration_number")
  verified           Boolean  @default(false)
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("psychologist_profiles")
}

model PatientPsychologistLink {
  id              String        @id @default(uuid())
  patientId       String        @map("patient_id")
  psychologistId  String        @map("psychologist_id")
  consentStatus   ConsentStatus @default(PENDING) @map("consent_status")
  createdAt       DateTime      @default(now()) @map("created_at")

  patient      User @relation("PatientLinks", fields: [patientId], references: [id], onDelete: Cascade)
  psychologist User @relation("PsychologistLinks", fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([patientId, psychologistId])
  @@map("patient_psychologist_links")
}

model EmotionalCheckin {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  moodScore     Int      // 1-10 scale
  energyLevel   Int      // 1-10 scale
  anxietyLevel  Int      // 1-10 scale
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emotional_checkins")
}

model JournalEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("journal_entries")
}