# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/emotional_app

# JWT
JWT_SECRET=changeme_in_production_please

# Login com Google (KAN-15) — Client ID de um OAuth Client "Web application"
# no Google Cloud Console. O mesmo valor vai também em
# NEXT_PUBLIC_GOOGLE_CLIENT_ID (frontend), pois o Google Identity Services
# roda no navegador; não há client secret aqui porque só verificamos o ID
# token assinado pelo Google, nunca trocamos código por token no backend.
GOOGLE_CLIENT_ID=

# Backend
PORT=3001
NODE_ENV=development

# CORS — obrigatório em produção (NODE_ENV=production); em desenvolvimento,
# localhost e IPs de rede local (10.x/172.16-31.x/192.168.x) já são aceitos
# automaticamente, sem precisar listar aqui. Lista separada por vírgulas,
# origens exatas (sem wildcard).
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=