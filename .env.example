# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/emotional_app

# JWT
JWT_SECRET=changeme_in_production_please

# Login com Google (KAN-15) — Client ID de um OAuth Client "Web application"
# no Google Cloud Console. O mesmo valor vai também em
# NEXT_PUBLIC_GOOGLE_CLIENT_ID (frontend), pois o Google Identity Services
# roda no navegador; não há client secret aqui porque só verificamos o ID
# token assinado pelo Google, nunca trocamos código por token no backend.
GOOGLE_CLIENT_ID=

# Login com Apple (KAN-16) — Services ID (identifier "com.seudominio.web")
# criado no Apple Developer com "Sign In with Apple" habilitado. Mesmo
# racional do Google: só verificamos o identityToken assinado pela Apple,
# nenhum client secret/chave privada é necessário para isso.
APPLE_CLIENT_ID=

# Recuperação de senha (KAN-17) — FRONTEND_URL é usado para montar o link
# enviado por e-mail (${FRONTEND_URL}/reset-password?token=...). Sem
# SMTP_HOST configurado, o e-mail não é enviado de verdade — o backend só
# loga um aviso (útil em dev/CI, onde não há servidor SMTP disponível).
FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@seudominio.com

# Backend
PORT=3001
NODE_ENV=development

# CORS — obrigatório em produção (NODE_ENV=production); em desenvolvimento,
# localhost e IPs de rede local (10.x/172.16-31.x/192.168.x) já são aceitos
# automaticamente, sem precisar listar aqui. Lista separada por vírgulas,
# origens exatas (sem wildcard).
# CORS_ALLOWED_ORIGINS=https://app.seudominio.com,https://admin.seudominio.com

# Rate limiting (KAN-18) — req.ip é a chave do limite por IP. Deixe vazio
# para conexão direta (padrão deste projeto, ver devOps/docker-compose.yml
# — nenhum proxy na frente). Se um proxy/ingress for introduzido em
# produção, defina o número de saltos confiáveis (normalmente 1). Ver
# IA/RATE_LIMITING_SETUP.md.
# TRUST_PROXY_HOPS=1

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=